{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ResizeInput",
  "title": "ResizeInput",
  "type": "object",
  "required": [
    "cpu_millis",
    "memory_gbs"
  ],
  "properties": {
    "cpu_millis": {
      "type": "string",
      "description": "The new CPU allocation in milli-cores.",
      "example": "1000"
    },
    "memory_gbs": {
      "type": "string",
      "description": "The new memory allocation in gigabytes.",
      "example": "4"
    }
  }
}